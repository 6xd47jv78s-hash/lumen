# Server-side keys. These are read only in API route handlers, so they never
# reach the browser — which is the whole reason a Node host (Vercel) unlocks
# data that a static host can't serve.
#
# Copy to .env.local for local development, or set them in your host's
# environment-variable settings for a deployment. Everything works without
# them; these only add the datasets that have no free keyless provider.

# Live stock and index candles/quotes. Free tier at twelvedata.com.
# Without it, /api/market/* returns 501 and the UI explains what's missing.
TWELVE_DATA_KEY=

# Optional upgrade for the headline wire. Free tier at marketaux.com.
# Without it the wire falls back to GDELT, which is keyless and works fine.
MARKETAUX_KEY=

# Canonical origin. Feeds metadata, the social card, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=
